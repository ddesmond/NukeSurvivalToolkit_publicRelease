import Gaffer
import GafferImage

__children = {}

__children["XSoften"] = GafferImage.Grade( "XSoften" )
parent.addChild( __children["XSoften"] )
__children["XSoften"]["user"].addChild( Gaffer.FloatPlug( "amount", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["XSoften"]["user"]["amount"], "label", "Amount" )
__children["XSoften"]["user"].addChild( Gaffer.FloatPlug( "radius", defaultValue = 2.0 ) )
Gaffer.Metadata.registerValue( __children["XSoften"]["user"]["radius"], "label", "Radius" )

Gaffer.Metadata.registerValue( parent, "description", "Softening.\n\nPorted from Nuke Survival Toolkit." )

del __children
