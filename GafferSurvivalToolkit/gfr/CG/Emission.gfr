import Gaffer
import GafferImage

__children = {}

__children["Emission"] = GafferImage.Grade( "Emission" )
parent.addChild( __children["Emission"] )
__children["Emission"]["user"].addChild( Gaffer.FloatPlug( "intensity", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["Emission"]["user"]["intensity"], "label", "Intensity" )
__children["Emission"]["user"].addChild( Gaffer.StringPlug( "color", defaultValue = "white" ) )
Gaffer.Metadata.registerValue( __children["Emission"]["user"]["color"], "label", "Color" )

Gaffer.Metadata.registerValue( parent, "description", "Emission/glow from CG.\n\nPorted from Nuke Survival Toolkit." )

del __children
