import Gaffer
import GafferImage

__children = {}

__children["Noise3DTexture"] = GafferImage.Grade( "Noise3DTexture" )
parent.addChild( __children["Noise3DTexture"] )
__children["Noise3DTexture"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["Noise3DTexture"]["user"]["scale"], "label", "Scale" )
__children["Noise3DTexture"]["user"].addChild( Gaffer.IntPlug( "seed", defaultValue = 0 ) )
Gaffer.Metadata.registerValue( __children["Noise3DTexture"]["user"]["seed"], "label", "Seed" )
__children["Noise3DTexture"]["user"].addChild( Gaffer.StringPlug( "type", defaultValue = "perlin" ) )
Gaffer.Metadata.registerValue( __children["Noise3DTexture"]["user"]["type"], "label", "Type" )

Gaffer.Metadata.registerValue( parent, "description", "3D noise texture.\n\nPorted from Nuke Survival Toolkit." )

del __children
