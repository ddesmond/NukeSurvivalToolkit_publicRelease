import Gaffer
import GafferImage

__children = {}

__children["CellNoise"] = GafferImage.Grade( "CellNoise" )
parent.addChild( __children["CellNoise"] )
__children["CellNoise"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["CellNoise"]["user"]["scale"], "label", "Scale" )
__children["CellNoise"]["user"].addChild( Gaffer.IntPlug( "seed", defaultValue = 0 ) )
Gaffer.Metadata.registerValue( __children["CellNoise"]["user"]["seed"], "label", "Seed" )
__children["CellNoise"]["user"].addChild( Gaffer.FloatPlug( "contrast", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["CellNoise"]["user"]["contrast"], "label", "Contrast" )

Gaffer.Metadata.registerValue( parent, "description", "Cell/Worley noise generator.\n\nPorted from Nuke Survival Toolkit." )

del __children
