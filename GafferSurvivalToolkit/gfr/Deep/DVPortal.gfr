import Gaffer
import GafferImage

__children = {}

__children["DVPortal"] = GafferImage.Grade( "DVPortal" )
parent.addChild( __children["DVPortal"] )
__children["DVPortal"]["user"].addChild( Gaffer.StringPlug( "depthRange", defaultValue = "0-1" ) )
Gaffer.Metadata.registerValue( __children["DVPortal"]["user"]["depthRange"], "label", "Depth Range" )
__children["DVPortal"]["user"].addChild( Gaffer.FloatPlug( "mix", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["DVPortal"]["user"]["mix"], "label", "Mix" )

Gaffer.Metadata.registerValue( parent, "description", "Deep portal/composite.\n\nPorted from Nuke Survival Toolkit." )

del __children
