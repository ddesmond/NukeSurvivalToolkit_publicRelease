import Gaffer
import GafferImage

__children = {}

__children["TProject2"] = GafferImage.Grade( "TProject2" )
parent.addChild( __children["TProject2"] )
__children["TProject2"]["user"].addChild( Gaffer.StringPlug( "transform", defaultValue = "" ) )
Gaffer.Metadata.registerValue( __children["TProject2"]["user"]["transform"], "label", "Transform Matrix" )
__children["TProject2"]["user"].addChild( Gaffer.StringPlug( "filter", defaultValue = "cubic" ) )
Gaffer.Metadata.registerValue( __children["TProject2"]["user"]["filter"], "label", "Filter" )
__children["TProject2"]["user"].addChild( Gaffer.BoolPlug( "premultiply", defaultValue = True ) )
Gaffer.Metadata.registerValue( __children["TProject2"]["user"]["premultiply"], "label", "Premultiply" )

Gaffer.Metadata.registerValue( parent, "description", "Transform projection v2.\n\nPorted from Nuke Survival Toolkit." )

del __children
