import Gaffer
import GafferImage

__children = {}

__children["ConvolutionMatrix"] = GafferImage.Grade( "ConvolutionMatrix" )
parent.addChild( __children["ConvolutionMatrix"] )
__children["ConvolutionMatrix"]["user"].addChild( Gaffer.IntPlug( "size", defaultValue = 3 ) )
Gaffer.Metadata.registerValue( __children["ConvolutionMatrix"]["user"]["size"], "label", "Kernel Size" )
__children["ConvolutionMatrix"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["ConvolutionMatrix"]["user"]["scale"], "label", "Scale" )

Gaffer.Metadata.registerValue( parent, "description", "Convolution matrix editor.\n\nPorted from Nuke Survival Toolkit." )

del __children
