import Gaffer
import GafferImage

__children = {}

__children["WhiteSoftClip"] = GafferImage.Grade( "WhiteSoftClip" )
parent.addChild( __children["WhiteSoftClip"] )
__children["WhiteSoftClip"]["user"].addChild( Gaffer.FloatPlug( "softClip", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["WhiteSoftClip"]["user"]["softClip"], "label", "Soft Clip" )
__children["WhiteSoftClip"]["user"].addChild( Gaffer.FloatPlug( "rollOff", defaultValue = 0.1 ) )
Gaffer.Metadata.registerValue( __children["WhiteSoftClip"]["user"]["rollOff"], "label", "Roll Off" )

Gaffer.Metadata.registerValue( parent, "description", "Soft clipping for whites.\n\nPorted from Nuke Survival Toolkit." )

del __children
