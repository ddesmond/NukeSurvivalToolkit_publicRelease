import Gaffer
import GafferImage

__children = {}

__children["CatsEyeDefocus"] = GafferImage.Grade( "CatsEyeDefocus" )
parent.addChild( __children["CatsEyeDefocus"] )
__children["CatsEyeDefocus"]["user"].addChild( Gaffer.FloatPlug( "size", defaultValue = 5.0 ) )
Gaffer.Metadata.registerValue( __children["CatsEyeDefocus"]["user"]["size"], "label", "Size" )
__children["CatsEyeDefocus"]["user"].addChild( Gaffer.FloatPlug( "aspect", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["CatsEyeDefocus"]["user"]["aspect"], "label", "Aspect" )
__children["CatsEyeDefocus"]["user"].addChild( Gaffer.FloatPlug( "rotation", defaultValue = 0.0 ) )
Gaffer.Metadata.registerValue( __children["CatsEyeDefocus"]["user"]["rotation"], "label", "Rotation" )

Gaffer.Metadata.registerValue( parent, "description", "Cat-eye bokeh defocus.\n\nPorted from Nuke Survival Toolkit." )

del __children
