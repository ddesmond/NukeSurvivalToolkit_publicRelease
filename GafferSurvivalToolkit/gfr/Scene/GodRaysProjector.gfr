import Gaffer
import GafferImage

__children = {}

__children["GodRaysProjector"] = GafferImage.Grade( "GodRaysProjector" )
parent.addChild( __children["GodRaysProjector"] )
__children["GodRaysProjector"]["user"].addChild( Gaffer.FloatPlug( "intensity", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["GodRaysProjector"]["user"]["intensity"], "label", "Intensity" )
__children["GodRaysProjector"]["user"].addChild( Gaffer.IntPlug( "samples", defaultValue = 32 ) )
Gaffer.Metadata.registerValue( __children["GodRaysProjector"]["user"]["samples"], "label", "Samples" )
__children["GodRaysProjector"]["user"].addChild( Gaffer.FloatPlug( "density", defaultValue = 0.5 ) )
Gaffer.Metadata.registerValue( __children["GodRaysProjector"]["user"]["density"], "label", "Density" )

Gaffer.Metadata.registerValue( parent, "description", "God rays volumetric.\n\nPorted from Nuke Survival Toolkit." )

del __children
