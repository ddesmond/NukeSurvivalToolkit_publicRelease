import Gaffer
import GafferImage

__children = {}

__children["VoronoiGradient"] = GafferImage.Grade( "VoronoiGradient" )
parent.addChild( __children["VoronoiGradient"] )
__children["VoronoiGradient"]["user"].addChild( Gaffer.IntPlug( "numPoints", defaultValue = 10 ) )
Gaffer.Metadata.registerValue( __children["VoronoiGradient"]["user"]["numPoints"], "label", "Number of Points" )
__children["VoronoiGradient"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["VoronoiGradient"]["user"]["scale"], "label", "Scale" )
__children["VoronoiGradient"]["user"].addChild( Gaffer.IntPlug( "seed", defaultValue = 0 ) )
Gaffer.Metadata.registerValue( __children["VoronoiGradient"]["user"]["seed"], "label", "Seed" )

Gaffer.Metadata.registerValue( parent, "description", "Voronoi pattern gradient.\n\nPorted from Nuke Survival Toolkit." )

del __children
