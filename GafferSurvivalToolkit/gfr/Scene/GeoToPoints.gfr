import Gaffer
import GafferImage

__children = {}

__children["GeoToPoints"] = GafferImage.Grade( "GeoToPoints" )
parent.addChild( __children["GeoToPoints"] )
__children["GeoToPoints"]["user"].addChild( Gaffer.FloatPlug( "density", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["GeoToPoints"]["user"]["density"], "label", "Density" )
__children["GeoToPoints"]["user"].addChild( Gaffer.BoolPlug( "randomize", defaultValue = True ) )
Gaffer.Metadata.registerValue( __children["GeoToPoints"]["user"]["randomize"], "label", "Randomize" )

Gaffer.Metadata.registerValue( parent, "description", "Geometry to point cloud.\n\nPorted from Nuke Survival Toolkit." )

del __children
