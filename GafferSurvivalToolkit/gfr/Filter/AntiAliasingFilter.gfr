import Gaffer
import GafferImage

__children = {}

__children["AntiAliasingFilter"] = GafferImage.Grade( "AntiAliasingFilter" )
parent.addChild( __children["AntiAliasingFilter"] )
__children["AntiAliasingFilter"]["user"].addChild( Gaffer.FloatPlug( "strength", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["AntiAliasingFilter"]["user"]["strength"], "label", "Strength" )
__children["AntiAliasingFilter"]["user"].addChild( Gaffer.StringPlug( "method", defaultValue = "supersample" ) )
Gaffer.Metadata.registerValue( __children["AntiAliasingFilter"]["user"]["method"], "label", "Method" )

Gaffer.Metadata.registerValue( parent, "description", "Anti-aliasing filter.\n\nPorted from Nuke Survival Toolkit." )

del __children
