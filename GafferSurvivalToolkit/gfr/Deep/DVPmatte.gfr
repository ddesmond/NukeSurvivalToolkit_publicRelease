import Gaffer
import GafferImage

__children = {}

__children["DVPmatte"] = GafferImage.Grade( "DVPmatte" )
parent.addChild( __children["DVPmatte"] )
__children["DVPmatte"]["user"].addChild( Gaffer.FloatPlug( "depthMin", defaultValue = 0.0 ) )
Gaffer.Metadata.registerValue( __children["DVPmatte"]["user"]["depthMin"], "label", "Depth Min" )
__children["DVPmatte"]["user"].addChild( Gaffer.FloatPlug( "depthMax", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["DVPmatte"]["user"]["depthMax"], "label", "Depth Max" )
__children["DVPmatte"]["user"].addChild( Gaffer.FloatPlug( "softness", defaultValue = 0.1 ) )
Gaffer.Metadata.registerValue( __children["DVPmatte"]["user"]["softness"], "label", "Softness" )

Gaffer.Metadata.registerValue( parent, "description", "Deep matte generation.\n\nPorted from Nuke Survival Toolkit." )

del __children
