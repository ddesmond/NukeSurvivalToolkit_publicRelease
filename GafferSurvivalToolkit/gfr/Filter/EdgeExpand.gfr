import Gaffer
import GafferImage

__children = {}

__children["EdgeExpand"] = GafferImage.Grade( "EdgeExpand" )
parent.addChild( __children["EdgeExpand"] )
__children["EdgeExpand"]["user"].addChild( Gaffer.FloatPlug( "amount", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["EdgeExpand"]["user"]["amount"], "label", "Amount" )
__children["EdgeExpand"]["user"].addChild( Gaffer.FloatPlug( "softness", defaultValue = 0.1 ) )
Gaffer.Metadata.registerValue( __children["EdgeExpand"]["user"]["softness"], "label", "Softness" )

Gaffer.Metadata.registerValue( parent, "description", "Edge expansion.\n\nPorted from Nuke Survival Toolkit." )

del __children
