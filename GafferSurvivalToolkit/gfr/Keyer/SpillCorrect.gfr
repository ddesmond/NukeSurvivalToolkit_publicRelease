import Gaffer
import GafferImage

__children = {}

__children["SpillCorrect"] = GafferImage.Grade( "SpillCorrect" )
parent.addChild( __children["SpillCorrect"] )
__children["SpillCorrect"]["user"].addChild( Gaffer.StringPlug( "spillColor", defaultValue = "green" ) )
Gaffer.Metadata.registerValue( __children["SpillCorrect"]["user"]["spillColor"], "label", "Spill Color" )
__children["SpillCorrect"]["user"].addChild( Gaffer.FloatPlug( "amount", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["SpillCorrect"]["user"]["amount"], "label", "Amount" )

Gaffer.Metadata.registerValue( parent, "description", "Spill correction.\n\nPorted from Nuke Survival Toolkit." )

del __children
