import Gaffer
import GafferImage

__children = {}

__children["iErode"] = GafferImage.Grade( "iErode" )
parent.addChild( __children["iErode"] )
__children["iErode"]["user"].addChild( Gaffer.FloatPlug( "size", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["iErode"]["user"]["size"], "label", "Size" )
__children["iErode"]["user"].addChild( Gaffer.BoolPlug( "edgeAware", defaultValue = True ) )
Gaffer.Metadata.registerValue( __children["iErode"]["user"]["edgeAware"], "label", "Edge Aware" )

Gaffer.Metadata.registerValue( parent, "description", "Intelligent erode.\n\nPorted from Nuke Survival Toolkit." )

del __children
