import Gaffer
import GafferImage

__children = {}

__children["PNoiseAdvanced"] = GafferImage.Grade( "PNoiseAdvanced" )
parent.addChild( __children["PNoiseAdvanced"] )
__children["PNoiseAdvanced"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["PNoiseAdvanced"]["user"]["scale"], "label", "Scale" )
__children["PNoiseAdvanced"]["user"].addChild( Gaffer.IntPlug( "seed", defaultValue = 0 ) )
Gaffer.Metadata.registerValue( __children["PNoiseAdvanced"]["user"]["seed"], "label", "Seed" )
__children["PNoiseAdvanced"]["user"].addChild( Gaffer.StringPlug( "type", defaultValue = "perlin" ) )
Gaffer.Metadata.registerValue( __children["PNoiseAdvanced"]["user"]["type"], "label", "Type" )

Gaffer.Metadata.registerValue( parent, "description", "Position-based noise.\n\nPorted from Nuke Survival Toolkit." )

del __children
