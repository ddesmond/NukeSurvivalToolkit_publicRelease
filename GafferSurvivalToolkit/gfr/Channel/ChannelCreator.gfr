import Gaffer
import GafferImage

__children = {}

__children["ChannelCreator"] = GafferImage.Grade( "ChannelCreator" )
parent.addChild( __children["ChannelCreator"] )
__children["ChannelCreator"]["user"].addChild( Gaffer.StringPlug( "channelName", defaultValue = "mask" ) )
Gaffer.Metadata.registerValue( __children["ChannelCreator"]["user"]["channelName"], "label", "Channel Name" )
__children["ChannelCreator"]["user"].addChild( Gaffer.FloatPlug( "channelValue", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["ChannelCreator"]["user"]["channelValue"], "label", "Channel Value" )

Gaffer.Metadata.registerValue( parent, "description", "Create new channels.\n\nPorted from Nuke Survival Toolkit." )

del __children
