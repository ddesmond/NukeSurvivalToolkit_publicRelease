import Gaffer
import GafferImage

__children = {}

__children["KeymixBBox"] = GafferImage.Grade( "KeymixBBox" )
parent.addChild( __children["KeymixBBox"] )
__children["KeymixBBox"]["user"].addChild( Gaffer.FloatPlug( "mix", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["KeymixBBox"]["user"]["mix"], "label", "Mix" )
__children["KeymixBBox"]["user"].addChild( Gaffer.BoolPlug( "autoBBox", defaultValue = True ) )
Gaffer.Metadata.registerValue( __children["KeymixBBox"]["user"]["autoBBox"], "label", "Auto BBox" )

Gaffer.Metadata.registerValue( parent, "description", "Keymix with bbox handling.\n\nPorted from Nuke Survival Toolkit." )

del __children
