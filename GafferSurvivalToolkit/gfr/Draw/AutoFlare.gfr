import Gaffer
import GafferImage

__children = {}

__children["AutoFlare"] = GafferImage.ImageReader( "AutoFlare" )
parent.addChild( __children["AutoFlare"] )
__children["AutoFlare"]["file"].setValue( '<<<replace>>>/images/flare.exr' )
__children["AutoFlare"]["user"].addChild( Gaffer.FloatPlug( "intensity", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["AutoFlare"]["user"]["intensity"], "label", "Intensity" )
__children["AutoFlare"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["AutoFlare"]["user"]["scale"], "label", "Scale" )

Gaffer.Metadata.registerValue( parent, "description", "Auto-tracking lens flare.\n\nPorted from Nuke Survival Toolkit." )

del __children
