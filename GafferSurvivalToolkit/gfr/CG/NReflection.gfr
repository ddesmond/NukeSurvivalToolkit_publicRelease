import Gaffer
import GafferImage

__children = {}

__children["NReflection"] = GafferImage.Grade( "NReflection" )
parent.addChild( __children["NReflection"] )
__children["NReflection"]["user"].addChild( Gaffer.FloatPlug( "intensity", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["NReflection"]["user"]["intensity"], "label", "Intensity" )
__children["NReflection"]["user"].addChild( Gaffer.FloatPlug( "blur", defaultValue = 0.5 ) )
Gaffer.Metadata.registerValue( __children["NReflection"]["user"]["blur"], "label", "Blur" )

Gaffer.Metadata.registerValue( parent, "description", "Normal-based reflection.\n\nPorted from Nuke Survival Toolkit." )

del __children
