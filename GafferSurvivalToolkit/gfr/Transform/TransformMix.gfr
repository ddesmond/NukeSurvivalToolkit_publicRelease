import Gaffer
import GafferImage

__children = {}

__children["TransformMix"] = GafferImage.Grade( "TransformMix" )
parent.addChild( __children["TransformMix"] )
__children["TransformMix"]["user"].addChild( Gaffer.FloatPlug( "mix", defaultValue = 0.5 ) )
Gaffer.Metadata.registerValue( __children["TransformMix"]["user"]["mix"], "label", "Mix" )
__children["TransformMix"]["user"].addChild( Gaffer.V2fPlug( "center", defaultValue = (0.5, 0.5) ) )
Gaffer.Metadata.registerValue( __children["TransformMix"]["user"]["center"], "label", "Center" )
__children["TransformMix"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["TransformMix"]["user"]["scale"], "label", "Scale" )
__children["TransformMix"]["user"].addChild( Gaffer.FloatPlug( "rotation", defaultValue = 0.0 ) )
Gaffer.Metadata.registerValue( __children["TransformMix"]["user"]["rotation"], "label", "Rotation" )

Gaffer.Metadata.registerValue( parent, "description", "Transform with mix.\n\nPorted from Nuke Survival Toolkit." )

del __children
