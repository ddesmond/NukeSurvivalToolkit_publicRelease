import Gaffer
import GafferImage

__children = {}

__children["DVPsetLight"] = GafferImage.Grade( "DVPsetLight" )
parent.addChild( __children["DVPsetLight"] )
__children["DVPsetLight"]["user"].addChild( Gaffer.FloatPlug( "intensity", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["DVPsetLight"]["user"]["intensity"], "label", "Intensity" )
__children["DVPsetLight"]["user"].addChild( Gaffer.StringPlug( "color", defaultValue = "white" ) )
Gaffer.Metadata.registerValue( __children["DVPsetLight"]["user"]["color"], "label", "Color" )

Gaffer.Metadata.registerValue( parent, "description", "Deep set light.\n\nPorted from Nuke Survival Toolkit." )

del __children
