import Gaffer
import GafferImage

__children = {}

__children["RainMaker"] = GafferImage.Grade( "RainMaker" )
parent.addChild( __children["RainMaker"] )
__children["RainMaker"]["user"].addChild( Gaffer.IntPlug( "count", defaultValue = 1000 ) )
Gaffer.Metadata.registerValue( __children["RainMaker"]["user"]["count"], "label", "Count" )
__children["RainMaker"]["user"].addChild( Gaffer.FloatPlug( "speed", defaultValue = 5.0 ) )
Gaffer.Metadata.registerValue( __children["RainMaker"]["user"]["speed"], "label", "Speed" )
__children["RainMaker"]["user"].addChild( Gaffer.FloatPlug( "wind", defaultValue = 0.0 ) )
Gaffer.Metadata.registerValue( __children["RainMaker"]["user"]["wind"], "label", "Wind" )

Gaffer.Metadata.registerValue( parent, "description", "Rain particle system.\n\nPorted from Nuke Survival Toolkit." )

del __children
