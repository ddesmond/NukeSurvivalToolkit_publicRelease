import Gaffer
import GafferImage

__children = {}

__children["HSLTool"] = GafferImage.Grade( "HSLTool" )
parent.addChild( __children["HSLTool"] )
__children["HSLTool"]["user"].addChild( Gaffer.FloatPlug( "hue", defaultValue = 0.0 ) )
Gaffer.Metadata.registerValue( __children["HSLTool"]["user"]["hue"], "label", "Hue Shift" )
__children["HSLTool"]["user"].addChild( Gaffer.FloatPlug( "saturation", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["HSLTool"]["user"]["saturation"], "label", "Saturation" )
__children["HSLTool"]["user"].addChild( Gaffer.FloatPlug( "lightness", defaultValue = 0.0 ) )
Gaffer.Metadata.registerValue( __children["HSLTool"]["user"]["lightness"], "label", "Lightness" )

Gaffer.Metadata.registerValue( parent, "description", "HSL color manipulation.\n\nPorted from Nuke Survival Toolkit." )

del __children
