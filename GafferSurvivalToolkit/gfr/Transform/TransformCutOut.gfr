import Gaffer
import GafferImage

__children = {}

__children["TransformCutOut"] = GafferImage.Grade( "TransformCutOut" )
parent.addChild( __children["TransformCutOut"] )
__children["TransformCutOut"]["user"].addChild( Gaffer.V2fPlug( "center", defaultValue = (0.5, 0.5) ) )
Gaffer.Metadata.registerValue( __children["TransformCutOut"]["user"]["center"], "label", "Center" )
__children["TransformCutOut"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["TransformCutOut"]["user"]["scale"], "label", "Scale" )
__children["TransformCutOut"]["user"].addChild( Gaffer.FloatPlug( "rotation", defaultValue = 0.0 ) )
Gaffer.Metadata.registerValue( __children["TransformCutOut"]["user"]["rotation"], "label", "Rotation" )

Gaffer.Metadata.registerValue( parent, "description", "Transform with cutout.\n\nPorted from Nuke Survival Toolkit." )

del __children
