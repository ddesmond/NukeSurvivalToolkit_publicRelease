import Gaffer
import GafferImage

__children = {}

__children["DVPrelight"] = GafferImage.Grade( "DVPrelight" )
parent.addChild( __children["DVPrelight"] )
__children["DVPrelight"]["user"].addChild( Gaffer.FloatPlug( "lightAngle", defaultValue = 45.0 ) )
Gaffer.Metadata.registerValue( __children["DVPrelight"]["user"]["lightAngle"], "label", "Light Angle" )
__children["DVPrelight"]["user"].addChild( Gaffer.FloatPlug( "intensity", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["DVPrelight"]["user"]["intensity"], "label", "Intensity" )

Gaffer.Metadata.registerValue( parent, "description", "Deep relight.\n\nPorted from Nuke Survival Toolkit." )

del __children
