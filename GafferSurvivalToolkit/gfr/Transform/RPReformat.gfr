import Gaffer
import GafferImage

__children = {}

__children["RPReformat"] = GafferImage.Grade( "RPReformat" )
parent.addChild( __children["RPReformat"] )
__children["RPReformat"]["user"].addChild( Gaffer.StringPlug( "format", defaultValue = "HD" ) )
Gaffer.Metadata.registerValue( __children["RPReformat"]["user"]["format"], "label", "Format" )
__children["RPReformat"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["RPReformat"]["user"]["scale"], "label", "Scale" )
__children["RPReformat"]["user"].addChild( Gaffer.StringPlug( "filter", defaultValue = "cubic" ) )
Gaffer.Metadata.registerValue( __children["RPReformat"]["user"]["filter"], "label", "Filter" )

Gaffer.Metadata.registerValue( parent, "description", "Reformat with controls.\n\nPorted from Nuke Survival Toolkit." )

del __children
