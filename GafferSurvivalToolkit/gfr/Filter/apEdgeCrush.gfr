import Gaffer
import GafferImage

__children = {}

__children["apEdgeCrush"] = GafferImage.Grade( "apEdgeCrush" )
parent.addChild( __children["apEdgeCrush"] )
__children["apEdgeCrush"]["user"].addChild( Gaffer.FloatPlug( "amount", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["apEdgeCrush"]["user"]["amount"], "label", "Amount" )
__children["apEdgeCrush"]["user"].addChild( Gaffer.FloatPlug( "softness", defaultValue = 0.1 ) )
Gaffer.Metadata.registerValue( __children["apEdgeCrush"]["user"]["softness"], "label", "Softness" )

Gaffer.Metadata.registerValue( parent, "description", "Crush/compress edges.\n\nPorted from Nuke Survival Toolkit." )

del __children
