import Gaffer
import GafferImage

__children = {}

__children["ChromaSmear"] = GafferImage.Grade( "ChromaSmear" )
parent.addChild( __children["ChromaSmear"] )
__children["ChromaSmear"]["user"].addChild( Gaffer.FloatPlug( "amount", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["ChromaSmear"]["user"]["amount"], "label", "Amount" )
__children["ChromaSmear"]["user"].addChild( Gaffer.FloatPlug( "threshold", defaultValue = 0.5 ) )
Gaffer.Metadata.registerValue( __children["ChromaSmear"]["user"]["threshold"], "label", "Threshold" )

Gaffer.Metadata.registerValue( parent, "description", "Chroma smear correction.\n\nPorted from Nuke Survival Toolkit." )

del __children
