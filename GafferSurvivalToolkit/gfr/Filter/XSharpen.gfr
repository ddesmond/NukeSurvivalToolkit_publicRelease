import Gaffer
import GafferImage

__children = {}

__children["XSharpen"] = GafferImage.Grade( "XSharpen" )
parent.addChild( __children["XSharpen"] )
__children["XSharpen"]["user"].addChild( Gaffer.FloatPlug( "amount", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["XSharpen"]["user"]["amount"], "label", "Amount" )
__children["XSharpen"]["user"].addChild( Gaffer.FloatPlug( "radius", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["XSharpen"]["user"]["radius"], "label", "Radius" )
__children["XSharpen"]["user"].addChild( Gaffer.FloatPlug( "threshold", defaultValue = 0.0 ) )
Gaffer.Metadata.registerValue( __children["XSharpen"]["user"]["threshold"], "label", "Threshold" )

Gaffer.Metadata.registerValue( parent, "description", "Sharpening.\n\nPorted from Nuke Survival Toolkit." )

del __children
