import Gaffer
import GafferImage

__children = {}

__children["VectorExtendEdge"] = GafferImage.Grade( "VectorExtendEdge" )
parent.addChild( __children["VectorExtendEdge"] )
__children["VectorExtendEdge"]["user"].addChild( Gaffer.FloatPlug( "length", defaultValue = 10.0 ) )
Gaffer.Metadata.registerValue( __children["VectorExtendEdge"]["user"]["length"], "label", "Length" )
__children["VectorExtendEdge"]["user"].addChild( Gaffer.StringPlug( "vectorChannel", defaultValue = "rgba" ) )
Gaffer.Metadata.registerValue( __children["VectorExtendEdge"]["user"]["vectorChannel"], "label", "Vector Channel" )

Gaffer.Metadata.registerValue( parent, "description", "Extend edges using vectors.\n\nPorted from Nuke Survival Toolkit." )

del __children
