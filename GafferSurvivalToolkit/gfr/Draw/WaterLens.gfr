import Gaffer
import GafferImage

__children = {}

__children["WaterLens"] = GafferImage.Grade( "WaterLens" )
parent.addChild( __children["WaterLens"] )
__children["WaterLens"]["user"].addChild( Gaffer.FloatPlug( "amplitude", defaultValue = 0.1 ) )
Gaffer.Metadata.registerValue( __children["WaterLens"]["user"]["amplitude"], "label", "Amplitude" )
__children["WaterLens"]["user"].addChild( Gaffer.FloatPlug( "frequency", defaultValue = 10.0 ) )
Gaffer.Metadata.registerValue( __children["WaterLens"]["user"]["frequency"], "label", "Frequency" )
__children["WaterLens"]["user"].addChild( Gaffer.FloatPlug( "speed", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["WaterLens"]["user"]["speed"], "label", "Speed" )
__children["WaterLens"]["user"].addChild( Gaffer.FloatPlug( "radius", defaultValue = 0.5 ) )
Gaffer.Metadata.registerValue( __children["WaterLens"]["user"]["radius"], "label", "Radius" )

Gaffer.Metadata.registerValue( parent, "description", "Water lens/refraction effect.\n\nPorted from Nuke Survival Toolkit." )

del __children
