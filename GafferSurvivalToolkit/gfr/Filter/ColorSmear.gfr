import Gaffer
import GafferImage

__children = {}

__children["ColorSmear"] = GafferImage.Grade( "ColorSmear" )
parent.addChild( __children["ColorSmear"] )
__children["ColorSmear"]["user"].addChild( Gaffer.FloatPlug( "amount", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["ColorSmear"]["user"]["amount"], "label", "Amount" )
__children["ColorSmear"]["user"].addChild( Gaffer.StringPlug( "direction", defaultValue = "outward" ) )
Gaffer.Metadata.registerValue( __children["ColorSmear"]["user"]["direction"], "label", "Direction" )

Gaffer.Metadata.registerValue( parent, "description", "Smear colors along edges.\n\nPorted from Nuke Survival Toolkit." )

del __children
