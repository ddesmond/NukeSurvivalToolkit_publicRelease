import Gaffer
import GafferImage

__children = {}

__children["aPCard"] = GafferImage.Grade( "aPCard" )
parent.addChild( __children["aPCard"] )
__children["aPCard"]["user"].addChild( Gaffer.FloatPlug( "depth", defaultValue = 0.0 ) )
Gaffer.Metadata.registerValue( __children["aPCard"]["user"]["depth"], "label", "Depth" )
__children["aPCard"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["aPCard"]["user"]["scale"], "label", "Scale" )

Gaffer.Metadata.registerValue( parent, "description", "Auto card from points.\n\nPorted from Nuke Survival Toolkit." )

del __children
