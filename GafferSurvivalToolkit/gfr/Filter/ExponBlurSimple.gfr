import Gaffer
import GafferImage

__children = {}

__children["ExponBlurSimple"] = GafferImage.Grade( "ExponBlurSimple" )
parent.addChild( __children["ExponBlurSimple"] )
__children["ExponBlurSimple"]["user"].addChild( Gaffer.FloatPlug( "size", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["ExponBlurSimple"]["user"]["size"], "label", "Size" )
__children["ExponBlurSimple"]["user"].addChild( Gaffer.FloatPlug( "exponent", defaultValue = 2.0 ) )
Gaffer.Metadata.registerValue( __children["ExponBlurSimple"]["user"]["exponent"], "label", "Exponent" )

Gaffer.Metadata.registerValue( parent, "description", "Exponential blur.\n\nPorted from Nuke Survival Toolkit." )

del __children
