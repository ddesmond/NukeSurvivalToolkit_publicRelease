import Gaffer
import GafferImage

__children = {}

__children["DVPrelightPT"] = GafferImage.Grade( "DVPrelightPT" )
parent.addChild( __children["DVPrelightPT"] )
__children["DVPrelightPT"]["user"].addChild( Gaffer.FloatPlug( "lightAngle", defaultValue = 45.0 ) )
Gaffer.Metadata.registerValue( __children["DVPrelightPT"]["user"]["lightAngle"], "label", "Light Angle" )
__children["DVPrelightPT"]["user"].addChild( Gaffer.FloatPlug( "intensity", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["DVPrelightPT"]["user"]["intensity"], "label", "Intensity" )

Gaffer.Metadata.registerValue( parent, "description", "Deep relight PT.\n\nPorted from Nuke Survival Toolkit." )

del __children
