import Gaffer
import GafferImage

__children = {}

__children["SkyMatte"] = GafferImage.Grade( "SkyMatte" )
parent.addChild( __children["SkyMatte"] )
__children["SkyMatte"]["user"].addChild( Gaffer.FloatPlug( "threshold", defaultValue = 0.5 ) )
Gaffer.Metadata.registerValue( __children["SkyMatte"]["user"]["threshold"], "label", "Threshold" )
__children["SkyMatte"]["user"].addChild( Gaffer.FloatPlug( "softness", defaultValue = 0.1 ) )
Gaffer.Metadata.registerValue( __children["SkyMatte"]["user"]["softness"], "label", "Softness" )
__children["SkyMatte"]["user"].addChild( Gaffer.FloatPlug( "blueBias", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["SkyMatte"]["user"]["blueBias"], "label", "Blue Bias" )

Gaffer.Metadata.registerValue( parent, "description", "Sky matte extraction.\n\nPorted from Nuke Survival Toolkit." )

del __children
