import Gaffer
import GafferImage

__children = {}

__children["CardToTrack_v9"] = GafferImage.Grade( "CardToTrack_v9" )
parent.addChild( __children["CardToTrack_v9"] )
__children["CardToTrack_v9"]["user"].addChild( Gaffer.StringPlug( "trackMethod", defaultValue = "planar" ) )
Gaffer.Metadata.registerValue( __children["CardToTrack_v9"]["user"]["trackMethod"], "label", "Track Method" )
__children["CardToTrack_v9"]["user"].addChild( Gaffer.FloatPlug( "confidence", defaultValue = 0.8 ) )
Gaffer.Metadata.registerValue( __children["CardToTrack_v9"]["user"]["confidence"], "label", "Confidence" )

Gaffer.Metadata.registerValue( parent, "description", "Card-to-track conversion v9.\n\nPorted from Nuke Survival Toolkit." )

del __children
