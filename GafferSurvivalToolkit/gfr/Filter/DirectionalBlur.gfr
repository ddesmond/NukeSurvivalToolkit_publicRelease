import Gaffer
import GafferImage

__children = {}

__children["DirectionalBlur"] = GafferImage.Grade( "DirectionalBlur" )
parent.addChild( __children["DirectionalBlur"] )
__children["DirectionalBlur"]["user"].addChild( Gaffer.FloatPlug( "angle", defaultValue = 0.0 ) )
Gaffer.Metadata.registerValue( __children["DirectionalBlur"]["user"]["angle"], "label", "Angle" )
__children["DirectionalBlur"]["user"].addChild( Gaffer.FloatPlug( "size", defaultValue = 5.0 ) )
Gaffer.Metadata.registerValue( __children["DirectionalBlur"]["user"]["size"], "label", "Size" )
__children["DirectionalBlur"]["user"].addChild( Gaffer.FloatPlug( "anisotropy", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["DirectionalBlur"]["user"]["anisotropy"], "label", "Anisotropy" )

Gaffer.Metadata.registerValue( parent, "description", "Directional/angle blur.\n\nPorted from Nuke Survival Toolkit." )

del __children
