import Gaffer
import GafferImage

__children = {}

__children["aeRefracTHOR"] = GafferImage.Grade( "aeRefracTHOR" )
parent.addChild( __children["aeRefracTHOR"] )
__children["aeRefracTHOR"]["user"].addChild( Gaffer.FloatPlug( "ior", defaultValue = 1.5 ) )
Gaffer.Metadata.registerValue( __children["aeRefracTHOR"]["user"]["ior"], "label", "IOR" )
__children["aeRefracTHOR"]["user"].addChild( Gaffer.FloatPlug( "thickness", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["aeRefracTHOR"]["user"]["thickness"], "label", "Thickness" )

Gaffer.Metadata.registerValue( parent, "description", "Refraction effect.\n\nPorted from Nuke Survival Toolkit." )

del __children
