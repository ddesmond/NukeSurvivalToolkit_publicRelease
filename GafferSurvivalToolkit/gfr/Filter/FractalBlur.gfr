import Gaffer
import GafferImage

__children = {}

__children["FractalBlur"] = GafferImage.Grade( "FractalBlur" )
parent.addChild( __children["FractalBlur"] )
__children["FractalBlur"]["user"].addChild( Gaffer.FloatPlug( "scale", defaultValue = 1.0 ) )
Gaffer.Metadata.registerValue( __children["FractalBlur"]["user"]["scale"], "label", "Scale" )
__children["FractalBlur"]["user"].addChild( Gaffer.FloatPlug( "detail", defaultValue = 0.5 ) )
Gaffer.Metadata.registerValue( __children["FractalBlur"]["user"]["detail"], "label", "Detail" )
__children["FractalBlur"]["user"].addChild( Gaffer.IntPlug( "seed", defaultValue = 0 ) )
Gaffer.Metadata.registerValue( __children["FractalBlur"]["user"]["seed"], "label", "Seed" )

Gaffer.Metadata.registerValue( parent, "description", "Fractal-based blur.\n\nPorted from Nuke Survival Toolkit." )

del __children
